# Скопируйте этот файл в ".env" и впишите свои данные
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
FROM_NAME=ProgForce
PORT=3000
# Адрес вашего сайта в интернете (для Google), например:
# SITE_URL=https://progforce.example.com

# Чат-бот (ключ берите на https://console.anthropic.com). Без ключа бот отвечать не будет.
ANTHROPIC_API_KEY=sk-ant-...
# CHAT_MODEL=claude-haiku-5-5

# Android-приложение (TWA). Заполните после первой сборки, см. mobile/ANDROID.md
# TWA_PACKAGE=com.progforce.app
# TWA_SHA256=AA:BB:CC:...   (SHA-256 отпечаток ключа подписи; можно несколько через запятую)

# Раздел «Запуск» (запуск кода C++ / Python)
# remote (по умолчанию) — код выполняется в онлайн-компиляторе Wandbox: безопасно для вашего сервера, нужен интернет.
# local — код выполняется на вашем сервере (нужны g++ и python3). Включайте только в Docker/на отдельной машине!
# RUN_MODE=remote
# RUN_TIME_LIMIT_MS=3000
# RUN_MEMORY_MB=512
# RUN_REQUIRE_LOGIN=1      # разрешить запуск только вошедшим пользователям
